
#include <iostream>
using namespace std;

int main() {
    int vector[3];
    int suma = 0;

    // Ingresar datos
    for (int i = 0; i < 3; i++) {
        cout << "Ingrese un numero: ";
        cin >> vector[i];
    }

    // Mostrar vector
    cout << "\nVector ingresado:\n";

    for (int i = 0; i < 3; i++) {
        cout << vector[i] << "\t";
        suma += vector[i];
    }

    cout << "\n\nLa suma total es: " << suma << endl;

    return 0;
}
